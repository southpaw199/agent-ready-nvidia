#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Mug" (
        prepend references = @./mug.usda@
        variants = {
            string color = "blue"
        }
        prepend variantSets = "color"
    )
    {
        variantSet "color" = {
            "blue" {
                color3f[] primvars:displayColor = [(0, 0, 1)]

            }
            "red" {
                color3f[] primvars:displayColor = [(1, 0, 0)]

            }
        }
    }
}

